# the-odds-api.com — now ONLY Goalscorers and AccaBonus (bet365 vs Pinnacle),
# until they move to OddsPapi. Blank = those two tools have no data.
ODDS_API_KEY=

# oddspapi.io — the cards tool's Paddy Power and Pinnacle corners/cards.
# ~290 requests/day at the defaults (ODDSPAPI_TTL_SECONDS=1800, 13
# tournaments, 5 per request, 2 bookmakers). Blank = no cards feed.
ODDSPAPI_API_KEY=
# Pinnacle's side from OddsPapi too. Blank = take it from bettingiscool.
# ODDSPAPI_FAIR_BOOK=pinnacle

# Odds cache TTL in seconds. Default 86400 (24 h) keeps the free tier safe.
# Only lower this on a paid Odds API tier — a 1 h cache burns ~336 credits/day
# on a single sport. Leave commented to use the 24 h default.
# ODDS_CACHE_TTL=86400

# Coupon tracker odds source. "bettingiscool" (default) is the only source:
# Pinnacle-native, de-vigged in-house, with the score grid the compound markets
# (Win-and-Over, Win-to-Nil, GG No Draw) are derived from. Without its key the
# tracker prices NOTHING, and /api/ready says so.
# COUPON_ODDS_SOURCE=bettingiscool

# bettingiscool API key (https://api.bettingiscool.com, X-API-Key header).
# Starter tier €49 = 15-min delayed prices. Billing is 1 token per request plus
# 1 token per row returned; empty responses still cost 1.
BETTINGISCOOL_API_KEY=

# Coupon tracker odds cache TTL in seconds, reused across all legs and the
# 10-min refresh loop. Default 600 matches the refresh cadence, which
# bettingiscool's per-DAY quota supports.
# COUPON_ODDS_CACHE_TTL=600

# Minutes past kickoff before a selection is cleared from its coupon. A coupon
# covers a WINDOW (Mon–Wed), so Monday's fixtures sit in a live coupon for days
# after they have played — the kickoff is what says a row is no longer a bet.
# The grace covers a printed kickoff being a few minutes out. Checked every
# 10 minutes and at startup.
# LEG_KICKOFF_GRACE_MINUTES=30

# Optional: restrict the AccaBonus feed to specific sport keys
# (comma-separated). Empty/unset = active leagues discovered from the free
# /v4/sports list, filtered to Acca Boost-eligible competitions
# (accabonus/arbs.py). Setting a single key caps the feed at ~1 API request
# per 24 h (quota testing). Remember to remove after testing — leaving it set
# silently blinds the tracker to every other league.
# ACCABONUS_SPORT_KEYS=tennis_atp

# Tool visibility. The suite currently surfaces ONLY the coupon tracker;
# AccaBonus and Cards/Corners are hidden (code kept — see PLAN.md v5). Their
# API routers only mount, and their nav tabs/routes only appear, when these are
# true. Flip to bring a tool back (rebuild the frontend after changing).
# ENABLE_ACCABONUS=false
# ENABLE_CARDS=false

# First-goalscorer value alerts (bet365 vs de-vigged Pinnacle). ON by default —
# surfaced as the "Scorers" tab. The scheduler builds a daily watchlist of major
# fixtures and scans each ~45 min before kickoff (Pinnacle only posts the market
# near KO for majors), storing value rows and alerting Discord on new value.
# ENABLE_GOALSCORERS=true
# Watchlist sport keys (default = big-five leagues + Champions League):
# GOALSCORER_SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league
# GOALSCORER_MIN_EDGE=0.0          # min edge vs fair to store/alert (0 = at/above fair)
# GOALSCORER_LEAD_MINUTES=45       # first scan this many minutes before kickoff
# GOALSCORER_INPLAY_INTERVAL=0     # in-play re-scan interval (min); 0 disables in-play
# GOALSCORER_INPLAY_WINDOW=40      # minutes after KO to keep in-play scanning

# OCR provider — set one key. GOOGLE_API_KEY takes priority over ANTHROPIC_API_KEY.
# Leave both blank to use MockOCRProvider (returns fake rows — useful for dev/testing).
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Discord webhook URL (optional — leave blank to disable notifications).
DISCORD_WEBHOOK_URL=

# Auth — session cookie signing key. Set a long random value in prod so sessions
# survive restarts (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# Leave blank in dev to auto-generate one per startup.
SECRET_KEY=

# Seed users: "user:pass[:perms],...". Created on startup if missing; existing
# users are NEVER modified, so changing a password (or a grant) means deleting
# the row too. Use long random values — login is public-facing, and the app
# warns at startup about any password that is guessable, equals the username,
# or is under 12 chars.
#
# The optional third field is the tool grant. "*" = every tool, present and
# future (admin). Otherwise tool names joined by "+": coupons, accabonus, cards.
# Omitted = "*". Seeing a tool means full use of it (no view-only tier). Because
# ":" separates the fields, passwords cannot contain ":".
#   AUTH_USERS=callum:LONG-RANDOM-PW:*, dave:ANOTHER-RANDOM-PW:coupons
AUTH_USERS=

# Static API key for GET /api/state (machine consumers — exposes coupons+legs,
# AccaBonus feed, cards feed as one JSON snapshot). Sent as the X-API-Key
# header. Generate like SECRET_KEY above. Leave blank to disable the endpoint.
STATE_API_KEY=

UPLOAD_DIR=uploads

# Largest coupon photo accepted, in MB. A phone photo is 2-6 MB, so 25 is
# generous. It exists because the request body is held in memory and then
# decoded and base64-encoded for OCR — one oversized upload could exhaust the
# instance. Raising it trades that headroom away; the image is never resized,
# because OCR accuracy on a coupon's small print needs the full resolution.
MAX_UPLOAD_MB=25
