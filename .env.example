# OddsPapi (oddspapi.io), the only odds source: Paddy, the coupon tracker and
# 2-Up all price from it. Paddy alone is ~146 requests/day at
# the defaults (ODDSPAPI_TTL_SECONDS=1800, 11 tournaments, 5 per request).
ODDSPAPI_API_KEY=
# Key the local Bookie Bashing scripts send with their fair prices — saves
# (local/bookiebashing_saves.py) and the Scraper (scraper/, on the Hub). Generate like
# SECRET_KEY. Blank = disabled.
SAVES_INGEST_KEY=

# Coupon tracker odds source. OddsPapi is the only source; this is the only
# accepted value and the default. Without ODDSPAPI_API_KEY the tracker runs on
# the mock and says so at boot and on /api/ready.
# COUPON_ODDS_SOURCE=oddspapi

# Coupon tracker odds cache TTL in seconds: the OddsPapi board is pulled and
# reused for this long across all legs + the 10-min refresh loop. Default 600
# (10 min, the refresh cadence; app/config.py). OddsPapi bills per request and
# the board is a handful of bulk requests per refresh, well within the plan.
# COUPON_ODDS_CACHE_TTL=600

# Minutes past kickoff before a selection is cleared from its coupon. A coupon
# covers a WINDOW (Mon–Wed), so Monday's fixtures sit in a live coupon for days
# after they have played — the kickoff is what says a row is no longer a bet.
# The grace covers a printed kickoff being a few minutes out. Checked every
# 10 minutes and at startup.
# LEG_KICKOFF_GRACE_MINUTES=30

# Tool visibility. A tool's API router only mounts, and its nav tab/route
# only appears, when its flag is true (rebuild the frontend after changing).
# ENABLE_CARDS=false

# First-goalscorer value alerts (bet365 vs de-vigged Pinnacle). PARKED (5 Nov
# 2026, docs/decisions.md): its vendor was removed, so it stays OFF until it
# returns on OddsPapi (PLAN.md, Parked). When it ran it was the "Scorers" tab:
# a daily watchlist of major fixtures, scanned ~45 min before kickoff.
# ENABLE_GOALSCORERS=false
# Watchlist sport keys (default = big-five leagues + Champions League):
# GOALSCORER_SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league
# GOALSCORER_MIN_EDGE=0.0          # min edge vs fair to store/alert (0 = at/above fair)
# GOALSCORER_LEAD_MINUTES=45       # first scan this many minutes before kickoff
# GOALSCORER_INPLAY_INTERVAL=0     # in-play re-scan interval (min); 0 disables in-play
# GOALSCORER_INPLAY_WINDOW=40      # minutes after KO to keep in-play scanning

# OCR provider — set one key. GOOGLE_API_KEY takes priority over ANTHROPIC_API_KEY.
# Leave both blank to use MockOCRProvider (returns fake rows — useful for dev/testing).
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Discord webhook URL (optional — leave blank to disable notifications).
DISCORD_WEBHOOK_URL=
# Optional per-tool / per-edge channels (notifications/routes.py). Tools:
# coupons, paddy, 365, aw26 (the Paddy health post, 08:47 London — the
# route kept AW 26's name when AW 26 was retired).
# tool@0.08=URL catches that tool's rows at +8% or better.
# Anything unrouted goes to DISCORD_WEBHOOK_URL. Example:
#   DISCORD_ROUTES=coupons=URL1 paddy=URL2 paddy@0.08=URL3 365=URL4
DISCORD_ROUTES=

# Auth — session cookie signing key. Set a long random value in prod so sessions
# survive restarts (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# Leave blank in dev to auto-generate one per startup.
SECRET_KEY=

# Seed users: "user:pass[:perms],...". Created on startup if missing; existing
# users are NEVER modified, so changing a password (or a grant) means deleting
# the row too. Use long random values — login is public-facing, and the app
# warns at startup about any password that is guessable, equals the username,
# or is under 12 chars.
#
# The optional third field is the tool grant. "*" = every tool, present and
# future (admin). Otherwise tool names joined by "+": coupons, accabonus, cards,
# hills, goalscorers, pnl, kelly, boost, shop, finder (render/api/app/security.py).
# finder is Callum's tips board: Callum's account only. "*" includes it,
# so give "*" to nobody but Callum, and always write a friend's grant out.
# Omitted = "*". Seeing a tool means full use of it (no view-only tier). Because
# ":" separates the fields, passwords cannot contain ":".
#   AUTH_USERS=callum:LONG-RANDOM-PW:*, dave:ANOTHER-RANDOM-PW:coupons
AUTH_USERS=

# The host `me` (Callum's personal tools: Finder, dogs, Virtuals, P&L, Kelly,
# the shop) is served on, with its own login (render/api/app/site.py). Blank =
# no `me`: those tools are served, and their accounts sign in, on the main
# domain. Set it only once the host resolves to the service: add the
# me.puntmore.com DNS record and the Render custom domain, check it resolves,
# then set ME_HOST=me.puntmore.com. Locally: me.localhost.
ME_HOST=

# Static API key for GET /api/state (machine consumers — exposes coupons+legs
# and the cards feed as one JSON snapshot). Sent as the X-API-Key
# header. Generate like SECRET_KEY above. Leave blank to disable the endpoint.
STATE_API_KEY=

UPLOAD_DIR=uploads
# A coupon and its photo are deleted this many days after upload. A coupon's
# window is a week at most, so after 8 days nothing on it can still be bet.
COUPON_CLEANUP_DAYS=8

# Largest coupon photo accepted, in MB. A phone photo is 2-6 MB, so 25 is
# generous. It exists because the request body is held in memory and then
# decoded and base64-encoded for OCR — one oversized upload could exhaust the
# instance. Raising it trades that headroom away; the image is never resized,
# because OCR accuracy on a coupon's small print needs the full resolution.
MAX_UPLOAD_MB=25

# --- 2-Up (365 tool, `accabonus` grant; render/api/app/twoup/) --------------
# Prices bet365's 2 Goals Ahead Early Payout off OddsPapi (needs
# ODDSPAPI_API_KEY) and serves the value bets as a one-way feed, rebuilt by the
# `twoup_refresh` job every TWOUP_FEED_TTL seconds. It never places a bet,
# keeps no account. Every value below is optional; the
# defaults are in app/config.py with their reasons.
# ENABLE_TWOUP=true
# Global kill switch: GET /api/2up/feed and the 2up source of /api/value are
# empty while it is on.
# TWOUP_KILL_SWITCH=false
# Qualifying competitions (ids or names). The default shares Pinnacle's
# request chunks with the coupon tracker; bet365 adds 2 requests a refresh.
# TWOUP_TOURNAMENT_IDS=17,18,24,8,23,35,34,238,7,679
# TWOUP_FEED_TTL=300             # seconds between refreshes of the served board
# TWOUP_HORIZON_HOURS=24
# TWOUP_MIN_LEAD_MINUTES=15
# TWOUP_MIN_EDGE=0.005           # probability units: P(win)+P(rescue)-1/price
# TWOUP_MIN_PRICE=1.25
# TWOUP_MAX_PRICE=8.0
# TWOUP_RESCUE_TABLE_PATH=       # blank = app/twoup/rescue_table.json

# --- Finder (Callum's tips, `finder` grant; render/api/app/finder/) ---
# Rows come from HubAI on the Hub over SAVES_INGEST_KEY (or an API client key with `ingest`); off = no routes, jobs or page.
# ENABLE_FINDER=true
