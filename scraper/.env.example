# Copy to /opt/puntmore-scraper/.env on the Hub. Never commit the real one.
# The native user service (puntmore-scraper, the default) and the Docker
# fallback for a box with no screen both read this file.
# (Docker env-files take everything after "=" literally - no inline comments.)

# Docker fallback only: password for VNC (logging in to Bookie Bashing,
# clearing a check by hand). The native service uses the real desktop.
VNC_PASSWORD=
# Discord webhook for "needs you" alerts
SCRAPER_ALERT_WEBHOOK=
# Dead-man's switch, e.g. a healthchecks.io ping URL
SCRAPER_HEALTHCHECK_URL=
# Where parsed prices are POSTed (a target's `post` path). Targets are
# data/targets.toml, not anything on Puntmore.
PUNTMORE_URL=https://puntmore.com
# Same value as SAVES_INGEST_KEY in puntmore's .env: the key on those POSTs
SAVES_INGEST_KEY=
# Raw samples kept on disk: the run's ceiling, and each tab's share of it, MB
SCRAPER_CAPTURE_MB=200
SCRAPER_CAPTURE_TAB_MB=8
