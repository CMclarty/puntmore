[Unit]
Description=Puntmore Scraper: one real Chrome on its own virtual screen, every target kept open (scraper/)
# Chrome runs on puntmore-screen.service (a headless sway with its own Xwayland,
# deploy/native/screen.conf), not on Callum's desktop, so nothing it does can take
# his screen, and it runs whether or not he is logged in. The screen writes its
# DISPLAY to %t/puntmore-screen.env and counts as started only once it has; a
# restart of the screen restarts the Scraper, and the Scraper never runs without it.
After=puntmore-screen.service
Requires=puntmore-screen.service
PartOf=puntmore-screen.service
# A crash loop (a bad deploy) must not reload pages forever: 5 starts in 10 min,
# then the unit stays failed and the Hub Console shows the Scraper down.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# install.sh writes the checkout's path here (the box's ~/Projects/puntmore).
WorkingDirectory=%h/Projects/puntmore
EnvironmentFile=/opt/puntmore-scraper/.env
# DISPLAY=:N, the screen's Xwayland (written by screen.conf).
EnvironmentFile=%t/puntmore-screen.env
# The user manager carries Callum's desktop session's display while he is logged
# in; Chrome must not see it. DISPLAY is not listed: it comes from the file above.
UnsetEnvironment=WAYLAND_DISPLAY XAUTHORITY
Environment=SCRAPER_DATA_DIR=/opt/puntmore-scraper/data
Environment=SCRAPER_PROFILE_DIR=/opt/puntmore-scraper/data/profile
Environment=SCRAPER_CHROME_PATH=/usr/bin/google-chrome
Environment=TZ=Europe/London
Environment=PYTHONUNBUFFERED=1
# Refuses to start while the Docker Scraper runs (one profile, one budget), and
# clears the lock a stopped container's Chrome left behind in the profile.
ExecStartPre=/bin/sh %h/Projects/puntmore/scraper/deploy/native/preflight.sh
ExecStart=%h/.venvs/puntmore/bin/python -m scraper run
# The Scraper exits on its own every 1.5-2 h (a fresh Playwright driver) and on
# its watchdog; both come back here.
Restart=always
RestartSec=10
# SIGTERM to python only: it closes its pages and Chrome itself. Whatever is
# left after TimeoutStopSec is killed.
KillMode=mixed
TimeoutStopSec=90
# The container had 3 GB; the box's RAM also holds HubAI's model (llama-server). Over
# this the kernel kills Chrome and the unit restarts it.
MemoryMax=4G

[Install]
WantedBy=default.target
