[Unit]
Description=Puntmore home box: persistent link to Render (bet lists in, reports out)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/puntmore/home
ExecStart=%h/.venvs/puntmore/bin/puntmore link
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
