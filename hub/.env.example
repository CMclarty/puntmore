# Copy to .env. Everything here is optional; defaults are safe (offline, dry-run).

# Identity on Render
PUNTMORE_CLIENT_ID=owner
PUNTMORE_RENDER_WS=wss://2up.puntmore.com/ws
PUNTMORE_RENDER_API_KEY=

# Safety. Leave dry-run on until two weeks of clean dry-run reports.
PUNTMORE_DRY_RUN=1

# The Worker (scraper/) writes its heartbeat, status.json and hub/ drop folders here.
# In the Docker setup that is the container's /data volume on the host.
PUNTMORE_WORKER_DATA=/opt/puntmore-scraper/data
PUNTMORE_WORKER_STALE_MINUTES=10

# Alerts and the local AI
PUNTMORE_DISCORD_WEBHOOK=
PUNTMORE_HERMES_BIN=/home/you/.local/bin/hermes
PUNTMORE_HERMES_PROFILE=default
PUNTMORE_ESCALATE_TO_LOCAL_AI=1
PUNTMORE_ALERT_DEDUP_HOURS=6

PUNTMORE_TZ=Europe/London
