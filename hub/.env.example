# Copy to .env. Everything here is optional; defaults are safe (offline, dry-run).

# Identity on Render
PUNTMORE_CLIENT_ID=owner
# The link socket: left BLANK since 6 Nov 2026. Render's end (/api/2up/ws) is gone (a Hub
# endpoint is per tool); blank, `puntmore link` runs the inbox and mail loops with no socket.
PUNTMORE_RENDER_WS=
# A Render API client key carrying `ingest`, for Finder's posts (`puntmore finder post|status`):
# in Render's shell, `python -m app.apikeys create <name> --tools ingest`. Sent as a Bearer key
# to PUNTMORE_RENDER_HTTP (below), which Finder needs set.
PUNTMORE_RENDER_API_KEY=

# Safety. Leave dry-run on until two weeks of clean dry-run reports.
PUNTMORE_DRY_RUN=1

# The Scraper (scraper/) writes its heartbeat, status.json and hub/ drop folders here: the
# native service's data dir (in the Docker fallback for a box with no screen, the container's
# /data volume on the host). The old names PUNTMORE_WORKER_DATA and
# PUNTMORE_WORKER_STALE_MINUTES are still read when these are unset.
PUNTMORE_SCRAPER_DATA=/opt/puntmore-scraper/data
PUNTMORE_SCRAPER_STALE_MINUTES=10
# The directory holding the Scraper's code (`scraper/`), which the console's Scraper tab imports
# to change targets.toml (scraper/targets.py, the only writer). Blank = the repo this hub/ is in.
PUNTMORE_SCRAPER_SRC=

# Alerts and HubAI (the Hermes layer)
PUNTMORE_DISCORD_WEBHOOK=
PUNTMORE_HERMES_BIN=/home/you/.local/bin/hermes
PUNTMORE_HERMES_PROFILE=default
# The profile that gets Scraper escalations (unhealthy_source, blocked_source) and follows the
# runbook deploy/hermes-skills/puntmore-scraper-ops, copied there by `puntmore update`.
PUNTMORE_HERMES_SCRAPER_PROFILE=scraper-manager
# Hand escalations to HubAI (the old name PUNTMORE_ESCALATE_TO_LOCAL_AI is still read).
PUNTMORE_ESCALATE_TO_HUBAI=1
PUNTMORE_ALERT_DEDUP_HOURS=6

PUNTMORE_TZ=Europe/London

# Tipster emails (puntmore mail; the link daemon polls on its own thread). One dedicated
# mailbox read over IMAP with SSL, on this box only: Render never polls a mailbox. A blank
# host means not configured and the poll is a no-op. Which senders are tipsters, and the
# parser for each, is data/tipsters.toml (see tipsters.example.toml; PUNTMORE_TIPSTERS_FILE
# points elsewhere).
PUNTMORE_IMAP_HOST=
PUNTMORE_IMAP_PORT=993
PUNTMORE_IMAP_USER=
PUNTMORE_IMAP_PASSWORD=
PUNTMORE_IMAP_FOLDER=INBOX
PUNTMORE_IMAP_EVERY_MIN=10
PUNTMORE_TIPSTERS_FILE=

# The Hub Console (`puntmore web`, systemd unit puntmore-web.service).
# Bound to localhost by default. Binding to the LAN address (e.g. 192.168.1.20:8090) exposes the
# actions (kill switch, resolve escalation, inbox, heartbeat, link-check, Scraper target edits) to anyone on the LAN:
# set a long random token then. A blank token disables every action; the read-only views still work.
PUNTMORE_WEB_BIND=127.0.0.1:8090
PUNTMORE_WEB_TOKEN=
# llama-server, for the Model card (GET /health, /slots, /props)
PUNTMORE_LLAMA_URL=http://127.0.0.1:8080
# The https base of Render (e.g. https://puntmore.com): its /api/ready health gate, and where
# Finder's rows go (/api/finder/rows). Blank = the Render card says "not configured" and
# `puntmore finder post` refuses.
PUNTMORE_RENDER_HTTP=
