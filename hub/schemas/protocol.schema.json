{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CMclarty/puntmore-hub/schemas/protocol.schema.json",
  "title": "Puntmore home <-> Render protocol, version 1",
  "description": "Every WebSocket frame is one envelope, and so is every file the Scraper drops for the Hub (types scraper_tips and scraper_event, never sent on the wire). body is validated according to type. See PROTOCOL.md.",
  "type": "object",
  "required": ["type", "client_id", "msg_id", "ts", "body"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": ["hello", "hello_ack", "bet_list", "scrape_job", "kill_switch", "ping", "pong", "ack",
               "report", "tip", "scrape_result", "escalation", "escalation_outcome",
               "scraper_tips", "scraper_event"]
    },
    "client_id": {"type": "string", "minLength": 1},
    "msg_id": {"type": "string", "minLength": 8},
    "ts": {"type": "string", "format": "date-time"},
    "body": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "hello"}}},            "then": {"properties": {"body": {"$ref": "#/$defs/hello"}}}},
    {"if": {"properties": {"type": {"const": "hello_ack"}}},        "then": {"properties": {"body": {"$ref": "#/$defs/hello_ack"}}}},
    {"if": {"properties": {"type": {"const": "bet_list"}}},         "then": {"properties": {"body": {"$ref": "#/$defs/bet_list"}}}},
    {"if": {"properties": {"type": {"const": "scrape_job"}}},       "then": {"properties": {"body": {"$ref": "#/$defs/scrape_job"}}}},
    {"if": {"properties": {"type": {"const": "kill_switch"}}},      "then": {"properties": {"body": {"$ref": "#/$defs/kill_switch"}}}},
    {"if": {"properties": {"type": {"const": "pong"}}},             "then": {"properties": {"body": {"$ref": "#/$defs/msg_ref"}}}},
    {"if": {"properties": {"type": {"const": "ack"}}},              "then": {"properties": {"body": {"$ref": "#/$defs/ack"}}}},
    {"if": {"properties": {"type": {"const": "report"}}},           "then": {"properties": {"body": {"$ref": "#/$defs/report"}}}},
    {"if": {"properties": {"type": {"const": "tip"}}},              "then": {"properties": {"body": {"$ref": "#/$defs/tip"}}}},
    {"if": {"properties": {"type": {"const": "scrape_result"}}},    "then": {"properties": {"body": {"$ref": "#/$defs/scrape_result"}}}},
    {"if": {"properties": {"type": {"const": "escalation"}}},       "then": {"properties": {"body": {"$ref": "#/$defs/escalation"}}}},
    {"if": {"properties": {"type": {"const": "escalation_outcome"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/escalation_outcome"}}}},
    {"if": {"properties": {"type": {"const": "scraper_tips"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/scraper_tips"}}}},
    {"if": {"properties": {"type": {"const": "scraper_event"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/scraper_event"}}}}
  ],
  "$defs": {
    "ts": {"type": "string", "format": "date-time"},
    "price": {"type": "number", "minimum": 1.0},
    "hello": {
      "type": "object",
      "required": ["protocol_version", "dry_run", "kill_switch"],
      "properties": {
        "protocol_version": {"const": 1},
        "dry_run": {"type": "boolean"},
        "kill_switch": {"type": "boolean"},
        "version": {"type": "string"}
      }
    },
    "hello_ack": {
      "type": "object",
      "required": ["protocol_version"],
      "properties": {"protocol_version": {"const": 1}, "server_time": {"$ref": "#/$defs/ts"}}
    },
    "bet_leg": {
      "type": "object",
      "required": ["event_id", "market", "selection", "price"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "market": {"type": "string", "minLength": 1},
        "selection": {"type": "string", "minLength": 1},
        "price": {"$ref": "#/$defs/price"}
      }
    },
    "bet": {
      "type": "object",
      "required": ["bet_id", "account_id", "legs", "stake", "expected_price", "bet_type"],
      "properties": {
        "bet_id": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "legs": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/bet_leg"}},
        "stake": {"type": "number", "exclusiveMinimum": 0},
        "expected_price": {"$ref": "#/$defs/price"},
        "bet_type": {"enum": ["single", "double", "treble", "fourfold", "cover"]},
        "not_before": {"type": ["string", "null"], "format": "date-time"},
        "not_after": {"type": ["string", "null"], "format": "date-time"},
        "source_scope": {"enum": ["shared", "owner"], "default": "shared"}
      }
    },
    "bet_list": {
      "type": "object",
      "required": ["bets"],
      "properties": {"bets": {"type": "array", "items": {"$ref": "#/$defs/bet"}}}
    },
    "scrape_job": {
      "type": "object",
      "required": ["job_id", "source"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "params": {"type": "object", "properties": {"force": {"type": "boolean"}}}
      }
    },
    "kill_switch": {
      "type": "object",
      "required": ["on"],
      "properties": {"on": {"type": "boolean"}, "reason": {"type": "string"}}
    },
    "msg_ref": {"type": "object", "required": ["msg_id"], "properties": {"msg_id": {"type": "string"}}},
    "ack": {
      "type": "object",
      "required": ["msg_id"],
      "properties": {"msg_id": {"type": "string"}, "replay": {"type": "boolean"}}
    },
    "report": {
      "type": "object",
      "required": ["kind", "ts"],
      "properties": {
        "kind": {"enum": ["placed", "price_changed", "failed", "settled", "balance"]},
        "ts": {"$ref": "#/$defs/ts"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "placed"}}},
         "then": {"required": ["bet_id", "actual_price", "dry_run"],
                  "properties": {"bet_id": {"type": "string"}, "actual_price": {"$ref": "#/$defs/price"}, "dry_run": {"type": "boolean"}}}},
        {"if": {"properties": {"kind": {"const": "price_changed"}}},
         "then": {"required": ["bet_id", "new_price"],
                  "properties": {"bet_id": {"type": "string"}, "new_price": {"$ref": "#/$defs/price"}}}},
        {"if": {"properties": {"kind": {"const": "failed"}}},
         "then": {"required": ["bet_id", "reason"],
                  "properties": {"bet_id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"kind": {"const": "settled"}}},
         "then": {"required": ["bet_id", "outcome", "return"],
                  "properties": {"bet_id": {"type": "string"}, "outcome": {"enum": ["won", "lost", "void", "partial"]}, "return": {"type": "number", "minimum": 0}}}},
        {"if": {"properties": {"kind": {"const": "balance"}}},
         "then": {"required": ["account_id", "balance"],
                  "properties": {"account_id": {"type": "string"}, "balance": {"type": "number"}}}}
      ]
    },
    "tip": {
      "type": "object",
      "required": ["tip_id", "source_id", "event", "market", "selection", "tip_time", "origin", "source_scope"],
      "properties": {
        "tip_id": {"type": "string", "minLength": 8},
        "source_id": {"type": "string", "minLength": 1},
        "event": {"type": "string", "minLength": 1},
        "market": {"type": "string", "minLength": 1},
        "selection": {"type": "string", "minLength": 1},
        "advised_price": {"anyOf": [{"$ref": "#/$defs/price"}, {"type": "null"}]},
        "advised_stake_units": {"type": ["number", "null"]},
        "tip_time": {"$ref": "#/$defs/ts"},
        "expiry": {"type": ["string", "null"], "format": "date-time"},
        "origin": {"enum": ["tipster", "scrape"]},
        "source_scope": {"const": "owner"},
        "extra": {"type": "object"}
      }
    },
    "scrape_result": {
      "type": "object",
      "required": ["job_id", "status"],
      "properties": {
        "job_id": {"type": "string"},
        "status": {"enum": ["ok", "empty", "parse_error", "blocked", "fetch_error", "skipped", "error"]},
        "items": {"type": "integer", "minimum": 0},
        "error": {"type": ["string", "null"]}
      }
    },
    "escalation": {
      "type": "object",
      "required": ["escalation_id", "kind", "ref", "detail", "created"],
      "properties": {
        "escalation_id": {"type": "integer"},
        "kind": {"enum": ["failed_bet", "unhealthy_source", "blocked_source", "kill_switch", "quarantined_item", "other"]},
        "ref": {"type": "string"},
        "detail": {"type": "string"},
        "created": {"$ref": "#/$defs/ts"}
      }
    },
    "escalation_outcome": {
      "type": "object",
      "required": ["escalation_id", "kind", "ref", "outcome"],
      "properties": {
        "escalation_id": {"type": "integer"},
        "kind": {"type": "string"},
        "ref": {"type": "string"},
        "outcome": {"type": "string", "minLength": 1}
      }
    },
    "scraper_tip_row": {
      "type": "object",
      "description": "One parsed row of a Bet Finder source; tip_id is minted here (scraper/ids.py) and travels unchanged",
      "required": ["event", "market", "selection"],
      "properties": {
        "tip_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "event": {"type": "string", "minLength": 1},
        "market": {"type": "string", "minLength": 1},
        "selection": {"type": "string", "minLength": 1},
        "advised_price": {"anyOf": [{"$ref": "#/$defs/price"}, {"type": "null"}]},
        "advised_stake_units": {"type": ["number", "null"]},
        "tip_time": {"type": ["string", "null"], "format": "date-time"},
        "expiry": {"type": ["string", "null"], "format": "date-time"},
        "origin": {"enum": ["tipster", "scrape"]},
        "extra": {"type": "object"}
      }
    },
    "scraper_tips": {
      "type": "object",
      "description": "One file per run of a fetch target, <scraper data>/hub/tips/<ms>-<source>.json",
      "required": ["source", "at", "url", "channel", "trust_weight", "rows"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "at": {"type": "number", "description": "unix seconds, UTC"},
        "url": {"type": "string", "minLength": 1},
        "channel": {"type": "string", "minLength": 1},
        "trust_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/scraper_tip_row"}}
      }
    },
    "scraper_event": {
      "type": "object",
      "description": "Something needing a decision, <scraper data>/hub/events/<ms>-<ref>.json; the Hub raises an escalation of the same kind",
      "required": ["kind", "ref", "detail", "at"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["unhealthy_source", "blocked_source"]},
        "ref": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "at": {"type": "number", "description": "unix seconds, UTC"}
      }
    }
  }
}
