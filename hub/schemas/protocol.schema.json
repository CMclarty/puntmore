{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CMclarty/puntmore/hub/schemas/protocol.schema.json",
  "title": "The Scraper's drop files, version 1",
  "description": "Every file the Scraper drops for the Hub is one envelope, of type scraper_tips, scraper_event or scraper_prices; body is validated according to type. See PROTOCOL.md.",
  "type": "object",
  "required": [
    "type",
    "client_id",
    "msg_id",
    "ts",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": [
        "scraper_tips",
        "scraper_event",
        "scraper_prices"
      ]
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "msg_id": {
      "type": "string",
      "minLength": 8
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "scraper_tips"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/scraper_tips"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scraper_event"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/scraper_event"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scraper_prices"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/scraper_prices"
          }
        }
      }
    }
  ],
  "$defs": {
    "price": {
      "type": "number",
      "minimum": 1.0
    },
    "scraper_tip_row": {
      "type": "object",
      "description": "One parsed row of a Finder source; tip_id is minted here (scraper/ids.py) and travels unchanged",
      "required": [
        "event",
        "market",
        "selection"
      ],
      "properties": {
        "tip_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "string",
          "minLength": 1
        },
        "advised_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/price"
            },
            {
              "type": "null"
            }
          ]
        },
        "advised_stake_units": {
          "type": [
            "number",
            "null"
          ]
        },
        "tip_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "origin": {
          "enum": [
            "tipster",
            "scrape"
          ]
        },
        "extra": {
          "type": "object"
        }
      }
    },
    "scraper_tips": {
      "type": "object",
      "description": "One file per run of a fetch target, <scraper data>/hub/tips/<ms>-<source>.json",
      "required": [
        "source",
        "at",
        "url",
        "channel",
        "trust_weight",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "number",
          "description": "unix seconds, UTC"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "trust_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scraper_tip_row"
          }
        }
      }
    },
    "scraper_event": {
      "type": "object",
      "description": "Something needing a decision, <scraper data>/hub/events/<ms>-<ref>.json; the Hub raises an escalation of the same kind",
      "required": [
        "kind",
        "ref",
        "detail",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "unhealthy_source",
            "blocked_source"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "at": {
          "type": "number",
          "description": "unix seconds, UTC"
        }
      }
    },
    "scraper_prices": {
      "type": "object",
      "description": "One file per parse of a Paddy price target, <scraper data>/hub/prices/<ms>-<source>-<msg_id[:8]>.json; the Hub posts the rows to route as {\"prices\": rows}. The rows pass through to Render unchanged: Render's handler is their validator, not this schema.",
      "required": [
        "source",
        "at",
        "url",
        "route",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "number",
          "description": "unix seconds, UTC"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "enum": [
            "/api/paddy/saves-fair",
            "/api/paddy/most-prices"
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
